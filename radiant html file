<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Radiant — Natural Repair, Effortless Shine</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-yellow: #D4AF37;
            --primary-brown: #6B4423;
            --light-brown: #8B6F47;
            --cream: #FFF8F0;
            --text-dark: #3D2817;
            --text-light: #7A6B5F;
            --white: #FFFFFF;
            --border-light: #E8DCD0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-dark);
            background-color: var(--white);
            line-height: 1.6;
        }

        /* NAVIGATION */
        nav {
            background: var(--white);
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-brown);
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo::before {
            content: '';
            width: 28px;
            height: 28px;
            background: linear-gradient(135deg, var(--primary-yellow), var(--primary-brown));
            border-radius: 50%;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        nav a {
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 500;
            transition: color 0.3s;
            cursor: pointer;
        }

        nav a:hover {
            color: var(--primary-yellow);
        }

        .nav-cta {
            background: var(--primary-yellow);
            color: var(--text-dark);
            padding: 0.7rem 1.5rem;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }

        .nav-cta:hover {
            background: var(--primary-brown);
            color: var(--white);
            transform: translateY(-2px);
        }

        /* PAGE CONTAINER */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        /* HERO SECTION */
        .hero {
            background: linear-gradient(135deg, var(--cream) 0%, #FFFBF7) 100%);
            padding: 4rem 2rem;
            text-align: center;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-content {
            max-width: 1200px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .hero-text h1 {
            font-size: 3.5rem;
            color: var(--primary-brown);
            margin-bottom: 1rem;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .hero-text p {
            font-size: 1.3rem;
            color: var(--text-light);
            margin-bottom: 2rem;
            font-style: italic;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .btn {
            padding: 1rem 2rem;
            border: none;
            border-radius: 30px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--primary-yellow);
            color: var(--text-dark);
        }

        .btn-primary:hover {
            background: var(--primary-brown);
            color: var(--white);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(107, 68, 35, 0.2);
        }

        .btn-secondary {
            background: transparent;
            color: var(--primary-brown);
            border: 2px solid var(--primary-brown);
        }

        .btn-secondary:hover {
            background: var(--primary-brown);
            color: var(--white);
            transform: translateY(-3px);
        }

        .hero-image {
            background: linear-gradient(135deg, var(--primary-yellow) 0%, var(--light-brown) 100%);
            border-radius: 20px;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 0.9rem;
            text-align: center;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(107, 68, 35, 0.15);
        }

        /* FEATURES GRID */
        .features {
            padding: 4rem 2rem;
            background: var(--white);
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            color: var(--primary-brown);
            margin-bottom: 3rem;
            font-weight: 700;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .feature-card {
            background: var(--cream);
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .feature-card:hover {
            border-color: var(--primary-yellow);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.15);
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary-yellow), var(--light-brown));
            border-radius: 50%;
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .feature-card h3 {
            color: var(--primary-brown);
            margin-bottom: 0.8rem;
            font-size: 1.3rem;
        }

        .feature-card p {
            color: var(--text-light);
            font-size: 0.95rem;
        }

        /* PRODUCT PAGE */
        .product-section {
            padding: 4rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .product-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .product-image {
            background: linear-gradient(135deg, var(--primary-yellow) 0%, var(--light-brown) 100%);
            border-radius: 20px;
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 0.9rem;
            text-align: center;
            box-shadow: 0 20px 50px rgba(107, 68, 35, 0.15);
        }

        .product-info h2 {
            font-size: 2.5rem;
            color: var(--primary-brown);
            margin-bottom: 1rem;
        }

        .price {
            font-size: 2rem;
            color: var(--primary-yellow);
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .product-benefits {
            background: var(--cream);
            padding: 1.5rem;
            border-radius: 10px;
            margin: 2rem 0;
        }

        .product-benefits h4 {
            color: var(--primary-brown);
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .benefits-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            color: var(--text-dark);
            font-size: 0.95rem;
        }

        .benefit-item::before {
            content: '✓';
            color: var(--primary-yellow);
            font-weight: 700;
            font-size: 1.3rem;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 2rem 0;
        }

        .quantity-selector label {
            color: var(--text-dark);
            font-weight: 600;
        }

        .quantity-selector input {
            width: 80px;
            padding: 0.7rem;
            border: 2px solid var(--border-light);
            border-radius: 8px;
            font-size: 1rem;
            text-align: center;
        }

        /* INGREDIENTS */
        .ingredients {
            padding: 4rem 2rem;
            background: linear-gradient(135deg, var(--cream) 0%, #FFFBF7) 100%);
        }

        .ingredients-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .ingredient-card {
            background: var(--white);
            padding: 1.5rem;
            border-radius: 12px;
            text-align: center;
            border: 2px solid var(--border-light);
            transition: all 0.3s;
        }

        .ingredient-card:hover {
            border-color: var(--primary-yellow);
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.1);
        }

        .ingredient-icon {
            width: 50px;
            height: 50px;
            background: var(--primary-yellow);
            border-radius: 50%;
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .ingredient-card h4 {
            color: var(--primary-brown);
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

        .ingredient-card p {
            color: var(--text-light);
            font-size: 0.85rem;
        }

        /* TESTIMONIALS */
        .testimonials {
            padding: 4rem 2rem;
            background: var(--white);
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .testimonial-card {
            background: var(--cream);
            padding: 2rem;
            border-radius: 12px;
            border-left: 4px solid var(--primary-yellow);
        }

        .stars {
            color: var(--primary-yellow);
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .testimonial-text {
            color: var(--text-dark);
            margin-bottom: 1rem;
            font-style: italic;
        }

        .testimonial-author {
            color: var(--primary-brown);
            font-weight: 600;
        }

        /* ABOUT PAGE */
        .about-section {
            padding: 4rem 2rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .about-text {
            font-size: 1.1rem;
            color: var(--text-dark);
            line-height: 1.8;
            margin-bottom: 2rem;
        }

        .mission-box {
            background: linear-gradient(135deg, var(--primary-yellow) 0%, var(--light-brown) 100%);
            color: var(--white);
            padding: 2.5rem;
            border-radius: 15px;
            margin: 3rem 0;
            text-align: center;
        }

        .mission-box h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        .mission-box p {
            font-size: 1.1rem;
            margin: 0;
        }

        /* CONTACT FORM */
        .contact-form {
            max-width: 600px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-dark);
            font-weight: 600;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 0.8rem;
            border: 2px solid var(--border-light);
            border-radius: 8px;
            font-family: inherit;
            font-size: 1rem;
            transition: border-color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-yellow);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 150px;
        }

        /* FOOTER */
        footer {
            background: var(--text-dark);
            color: var(--white);
            padding: 3rem 2rem;
            text-align: center;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            text-align: left;
            margin-bottom: 2rem;
        }

        .footer-section h4 {
            color: var(--primary-yellow);
            margin-bottom: 1rem;
        }

        .footer-section p,
        .footer-section a {
            color: #CCC;
            font-size: 0.95rem;
            text-decoration: none;
            margin-bottom: 0.5rem;
            display: block;
        }

        .footer-section a:hover {
            color: var(--primary-yellow);
        }

        .footer-bottom {
            border-top: 1px solid #444;
            padding-top: 2rem;
            color: #AAA;
            font-size: 0.9rem;
        }

        /* ORDER PAGE */
        .checkout-container {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
        }

        .order-form {
            background: var(--cream);
            padding: 2rem;
            border-radius: 12px;
        }

        .order-form h3 {
            color: var(--primary-brown);
            margin-bottom: 1.5rem;
            font-size: 1.3rem;
        }

        .cart-summary {
            background: var(--white);
            padding: 2rem;
            border-radius: 12px;
            border: 2px solid var(--border-light);
            height: fit-content;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-light);
        }

        .cart-item-details h4 {
            color: var(--primary-brown);
            margin-bottom: 0.3rem;
        }

        .cart-item-details p {
            color: var(--text-light);
            font-size: 0.9rem;
            margin: 0;
        }

        .cart-item-price {
            color: var(--primary-yellow);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .cart-total {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-brown);
            text-align: right;
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 2px solid var(--primary-yellow);
        }

        .payment-methods {
            margin: 2rem 0;
        }

        .payment-methods h4 {
            color: var(--primary-brown);
            margin-bottom: 1rem;
        }

        .payment-option {
            display: flex;
            align-items: center;
            padding: 1rem;
            border: 2px solid var(--border-light);
            border-radius: 8px;
            margin-bottom: 0.8rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .payment-option:hover {
            border-color: var(--primary-yellow);
            background: #FFFBF7;
        }

        .payment-option input[type="radio"] {
            margin-right: 1rem;
        }

        /* GALLERY */
        .gallery-preview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin: 2rem 0;
        }

        .gallery-item {
            background: linear-gradient(135deg, var(--primary-yellow) 0%, var(--light-brown) 100%);
            border-radius: 10px;
            height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 0.85rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .gallery-item:hover {
            border-color: var(--white);
            transform: scale(1.05);
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            nav ul {
                gap: 1rem;
                font-size: 0.9rem;
            }

            .hero-content {
                grid-template-columns: 1fr;
            }

            .hero-text h1 {
                font-size: 2rem;
            }

            .product-layout,
            .checkout-layout {
                grid-template-columns: 1fr;
            }

            .benefits-list {
                grid-template-columns: 1fr;
            }

            .hero-buttons {
                justify-content: center;
            }

            .section-title {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
